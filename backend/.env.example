# Application
PROJECT_NAME="DisasterFlow Production API"
VERSION="1.0.0"
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@db:5432/disasterflow

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
SECRET_KEY=your-super-secret-jwt-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (CrewAI)
OPENAI_API_KEY=your-openai-api-key-here
# Or if using Local Ollama:
# OPENAI_API_BASE=http://host.docker.internal:11434/v1
# OPENAI_MODEL_NAME=phi3
